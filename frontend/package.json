{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "cd .. && husky frontend/.husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "vitest related --run --passWithNoTests"
    ]
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "vega-embed": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "size-limit": "^11.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "size-limit": [
    {
      "name": "main chunk (everything signed-in, plus the public pages)",
      "path": "dist/assets/index-*.js",
      "limit": "520 kB"
    },
    {
      "name": "guide detail (lazy)",
      "path": "dist/assets/GuideDetailPage-*.js",
      "limit": "45 kB"
    },
    {
      "name": "stylesheet",
      "path": "dist/assets/index-*.css",
      "limit": "8 kB"
    }
  ]
}
