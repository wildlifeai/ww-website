# Wildlife Watcher Website — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values for your target environment.
#
#
# SECURITY: .env is gitignored. NEVER commit real keys.
# ─────────────────────────────────────────────────────────────────────

# For dev, uncomment:

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Azure Storage (Temporary Image Buffer) ───────────────────────────
AZURE_STORAGE_CONTAINER_NAME=

# ── Google Drive (Async Upload) ──────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=

# ── Frontend (Vite injects at build time) ────────────────────────────
# For local dev, uncomment:
VITE_API_BASE_URL=
# Public web OAuth client ID for Google's sign-in button; empty = the redirect flow
VITE_GOOGLE_CLIENT_ID=

# # For remote dev, uncomment:
# VITE_API_BASE_URL=



# For staging, uncomment:
# ── Supabase ─────────────────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# # ── Azure Storage (Temporary Image Buffer) ───────────────────────────
# AZURE_STORAGE_CONTAINER_NAME=

# ── Google Drive (Async Upload) ──────────────────────────────────────
# GOOGLE_DRIVE_FOLDER_ID=

# ── Frontend (Vite injects at build time) ────────────────────────────
# VITE_API_BASE_URL=



# ── Security ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_PER_MINUTE=60

# ── Azure Storage (Temporary Image Buffer) ───────────────────────────
AZURE_STORAGE_CONNECTION_STRING=


# ── Google Drive (Async Upload) ──────────────────────────────────────
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_MAX_FILE_SIZE_MB=4

# ── General ──────────────────────────────────────────────────────────
GENERAL_ORG_ID=b0000000-0000-0000-0000-000000000001

# ── Feature Flags ────────────────────────────────────────────────────
FF_INAT_ENABLED=false
FF_ML_ENABLED=false
FF_CLUSTERING_ENABLED=false
FF_PUBLIC_API_ENABLED=false

# ── Observability ────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Redis (future — not yet required) ────────────────────────────────
REDIS_URL=

# ── iNaturalist (Phase 6 — not yet implemented) ─────────────────────
INAT_CLIENT_ID=
INAT_CLIENT_SECRET=
INAT_REDIRECT_URI=

# ── Demo account (optional) ──────────────────────────────────────────
# Shared read-only account behind the "Try the demo" button. Seed it
# with scripts/seed_demo.py; leave empty to disable the demo endpoint.
DEMO_EMAIL=
DEMO_PASSWORD=


